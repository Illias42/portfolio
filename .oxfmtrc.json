{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "./src/app/styles/globals.css",
    "functions": ["cn", "clsx", "cva"]
  },
  "ignorePatterns": [
    ".next",
    "out",
    "node_modules",
    "public",
    "bun.lock",
    ".claude/worktrees",
    "next-env.d.ts"
  ]
}
